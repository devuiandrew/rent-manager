# Скопіюй у .env.development (git його ігнорує — створюється на кожній машині):
#   copy .env.development.example .env.development
# Використовується в dev-режимі: npm run dev / dev:all / dev:web / electron:dev
# ⚠️ dev:all та dev:web піднімають Django на порту 8001 (prod займає 8000) —
# без цього файлу фронт піде на localhost:8000 і дані не завантажаться
VITE_API_URL=http://localhost:8001/api

# Якщо dev-бекенд крутиться на іншій машині в мережі — вказати її IP:
# VITE_API_URL=http://192.168.1.100:8001/api
