# Скопіюй цей файл у .env — значення нижче робочі для розробки на будь-якій машині:
#   copy .env.example .env      (PowerShell / cmd)
#   cp .env.example .env        (Git Bash / WSL)
# ⚠️ DB_ENGINE задати обов'язково — без нього Django не стартує

# ─── Django ───────────────────────────────────────────
# Для розробки можна лишити як є. Для production згенерувати свій ключ:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-only-rent-manager
DEBUG=True
ALLOWED_HOSTS=*

# Версія фронта, яку роздали клієнтам зараз (для сповіщення «вийшла нова версія» в застосунку).
# Піднімати вручну при кожному релізі + перезапустити Waitress
LATEST_VERSION=1.6.0

# ─── CORS ─────────────────────────────────────────────
# True — дозволити всі origins (тільки для розробки!)
CORS_ALLOW_ALL_ORIGINS=True
# Для production вказати конкретні origins через кому:
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.100:5173

# ─── База даних ───────────────────────────────────────
# Варіант 1 — SQLite: нуль налаштувань, працює одразу (для швидкого тесту на новій машині).
# Файл БД створюється відносно поточної папки — команди manage.py запускати з backend/
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Варіант 2 — PostgreSQL dev (основні робочі машини, БД rent_manager_dev):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=rent_manager_dev
# DB_USER=rent_user
# DB_PASSWORD=пароль-rent_user-на-цій-машині
# DB_HOST=localhost
# DB_PORT=5432

# Варіант 3 — PostgreSQL production (тільки папка rent_manager_production!):
# як варіант 2, але DB_NAME=rent_manager + DEBUG=False + свій SECRET_KEY
# + конкретні ALLOWED_HOSTS і CORS_ALLOWED_ORIGINS

# ─── Waitress (production-сервер, serve.py) ───────────
# WAITRESS_HOST=0.0.0.0
# WAITRESS_PORT=8000
# WAITRESS_THREADS=8
